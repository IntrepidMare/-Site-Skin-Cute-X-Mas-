:root {
    --color1: #d6d68c;
    --color2: #bfd3b7;
    --color3: #f5f5d1;
    --color4: #ca7560;
    --color5: #5d3d03;
    --color6: #cfd28b;
    --color7: #fffffe;
}

html,
#outer {
    background: var(--color2);
}

body,
a.tag,
a.tag:visited {
    color: var(--color5);
}

.listbox .heading a.tag:visited:hover {	 
    background: var(--color7);	 
    color: var(--color5);	 
}

a.tag:hover,
li.blurb ul.tags li.relationships a:hover {
    background: var(--color4);
}

.actions .input:hover {
    color: var(--color5);
    box-shadow: none;
}

h1, h2, h3 {
    word-break: break-all;
    /* not supported in all browsers, so we need break-all as a fallback */
    word-break: break-word;
}

/*  ----------- Font family ---------  */

.toggled form,
.dynamic form,
.secondary,
.dropdown,
input,
textarea,
button,
#main.errors p {
    font-family: "Nunito", "Verdana", "Helvetica", "Lucida Grande", "Lucida Sans Unicode", sans-serif, "GNU Unifont";
}

heading,
h1,
h2,
h3,
h4,
h5,
h6,
.heading,
#header .primary a,
#dashboard a,
#dashboard .current,
#dashboard span,
a.work,
.bookmark .user .meta {
    font-family: "Konde", "Georgia", serif;
    font-size: 90%;
}

body,
blockquote,
pre,
.heading .actions,
.heading .action,
.heading span.actions,
span.unread,
.replied,
span.claimed,
.actions span.defaulted,
.prompt .blurb h6 {
    font-family: "Nunito", "Lucida Grande", "Lucida Sans Unicode", "Verdana", "Helvetica", sans-serif, "GNU Unifont";
    font-size: 95%;
    letter-spacing: 0.0625em;
}

/*  HEADER  */

#header {
    background-image: url("https://i.ibb.co/TBB9bFRM/cute.png");
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: cover;
}

header h1.heading a::before {
    content: "HO HO HO!";
    font-weight: bold;
    text-shadow: 0.0625em 0.0625em 0.1875em black;
}

#header h1.heading span {
    display: none;
}

#header .heading a {
    color: var(--color4);
    font-size: 2.75em;
}

#header .logo {
  float: left;
  background: url("https://i.ibb.co/Y4HTYpzT/ao3-logo.png");
  width: 0 !important;
  height: 0 !important;
  padding: 0.8em;
  background-repeat: no-repeat;
}

#greeting {
    margin: 20em 0.375em 0.125em;
    border-radius: 0 0.5em;
    padding: 0 0 0.3em 0.5em;
}

#small_login .action {
    background: var(--color4);
    border-radius: 0.5em 0;
    border: black dotted 0.125em;
    margin: 0 0.25em;
    color: var(--color5);
}

#header .user a,
#header .user a:visited {
    background: var(--color4);
    border-radius: 0.5em 0;
    margin: 0 0.25em;
    color: var(--color5);
    box-shadow: -0.25em -0.25em 1em black;
}

#greeting > p > a > img {
    border-radius: 0 0.5em;
}

#greeting p.icon {
    float: right;
    padding: 0.429em 0.125em 0 0;
    line-height: 1;
    height: 0;
    width: 2em;
}

#greeting img.icon {
    height: 1.786em;
    width: 1.786em;
    background-size: 100%;
    box-shadow: -0.25em -0.25em 1em black;
    border: solid var(--color5) 0.25em;
}

#greeting > ul > li:nth-child(3) > a:hover {
    box-shadow: black 0.3125em 0.3125em 2em;
}

#header .primary {
    background: var(--color1);
    height: 3em;
    padding: 0.9em 0 0;
}

#header .primary a,
#header .primary .dropdown:hover a {
    margin: 0 0.5em;
    color: var(--color7);
    box-shadow: -0.25em -0.25em 1em black;
    border-radius: 0.5em 0;
    background: var(--color4);
}

#header .primary .menu a {
    color: var(--color5);
    background: var(--color4);
}

#header .menu:hover,
#header .primary a:hover {
    color: var(--color5);
    background: var(--color2);
}

#header .primary a:focus {
    color: var(--color5);
    background: var(--color4);
}

#header .menu li:hover,
#header .primary .menu a:hover {
    color: var(--color5);
    background: var(--color1);
}

#header .actions a:hover,  
#header .dropdown:hover a,
#header .primary .menu, 
    background: var(--color4);
    border-radius: 0.8em 0;
}

#header .open .menu,
#header .menu li,
#header .open a, 
.actions a:active,
#header .actions a:focus {
    background: var(--color4);
    border-radius: 0 0.8em;
}

#header .dropdown:hover .menu,
#header .actions a:hover {
    background: var(--color4);
    border-radius: 0.8em 0;
    color: var(--color5);
}

#header .primary .dropdown a:active {
    background: var(--color4);
}

/* line between buttons */
#header .menu li {
    border-bottom: 0.0125em solid white;
    text-align: center;
    border-radius: 0 0.8em;
}

#header .menu li:hover {
    border-bottom: 0.0125em solid white;
    text-align: center;
    border-radius: 0.8em 0;
}

/*  Search  */

#header #search .button {
    background: var(--color4);
}

.actions input,
input[type="submit"],
form.search input[type="text"],
#header #search input:focus {
    color: var(--color5);
    padding: 0.25em 0.75em;
}

#header .search {
    float: right;
    color: var(--color5);
    margin-right: 0.25em;
}

#header #search input:focus {
    outline: 1px dotted;
}

#header #search .text {
    margin: 0.2857em 0.429em;
}

/*  Main page  */

.splash .module h3 {
    color: var(--color4);
}

.splash .favorite li:nth-of-type(odd) a {
    background: var(--color3);
    color: var(--color5);
    border-radius: 0 0.5em;
    margin: 0;
    box-shadow: black 0.3125em 0.3125em 2em;
}

.splash .favorite li:nth-of-type(even) a {
    background: var(--color5);
    color: var(--color7);
    border-radius: 0 0.5em;
    margin: 0;
    box-shadow: black 0.3125em 0.3125em 2em;
}

.splash .favorite li:nth-of-type(odd) a:hover {
    background: var(--color4);
    color: var(--color7);
    border-radius: 0.5em 0;
    margin: 0;
    box-shadow: black 0.3125em 0.3125em 2em;
}

.splash .favorite li:nth-of-type(even) a:hover {
    background: var(--color1);
    color: var(--color4);
    border-radius: 0.5em 0;
    margin: 0;
    box-shadow: black 0.3125em 0.3125em 2em;
}

a,
a:link {
    color: var(--color5);
    padding: 0.125em;
    line-height: 2;
}

a:hover,
a:link:hover {
    background: var(--color4);
    padding: 0.125em;
    border-radius: 0 0.5em;
    color: var(--color5);
}

a:visited {
    color: var(--color4);
    text-decoration: none;
    border-bottom: 1px dashed;
}

h3,
h4 {
    text-transform: uppercase;
    font-weight: bolder;
    color: var(--color5);
}

.logged-in .splash > .module {
    width: 100%;
}

.system .userstuff {
    max-width: 80em;
}

.favorite.module.odd ul {
    width: 70%;
    margin: 0 0 0 5rem;
}

.favorite.module.odd ul li {
    border-radius: 0.5em 0;
}

.reading h4.viewed {
    background: var(--color4);
    padding: 0.25em;
    border-radius: 0.5em 0;
    box-shadow: -0.25em 0.25em 1em black;
    margin: 1.5em 6em 0;
    text-transform: none;
    font-size: 90%;
}

.reading h4.viewed span {
    text-transform: uppercase;
    font-weight: bold;
}

.splash .favorite .latest.messages .actions a {	 
    display: inline-block !important;	 
    background: none !important;	 
    border: 0.125em solid !important;	 
    border-radius: 0 0.5em;	 
    color: var(--color5) !important;	 
    padding: 0.25em 0.75em !important;	 
}	 
 	 
.comment .actions {	 
    float: right;	 
    text-align: right;	 
}

/*  FOOTER  */

#footer {
    background: var(--color1);
    color: var(--color5);
}

#footer .heading {
    color: var(--color5);
    font-weight: bold;
}

#footer button,
#footer a {
    color: var(--color5);
    padding: 0.25em;
}

#footer button:hover,
#footer a:hover {
    background: var(--color4);
    padding: 0.25em;
    border-radius: 0 0.5em;
}

form.button_to,
ul.navigation.actions li form {
    background: none;
}

/*  USER DASH  */

#dashboard.own {
    border-top: 0;
    border-bottom: 0;
    margin: 0 10%;
}

#dashboard {
    float: none;
    width: 80vw;
}

#dashboard ul {
    float: none;
    display: block;
    padding: 0.186em 0;
    text-align: center;
    border-top: none;
    position: relative;
}

#dashboard .current {
    background: var(--color3);
    color: var(--color5);
    border-radius: 0.5em 0;
    margin: 0.3125em 0;
    box-shadow: black 0.125em 0.125em 1.5em;
}
#dashboard .current:hover {
    background: var(--color5);
    color: var(--color3);
    border-radius: 0 0.5em;
    margin: 0.3125em 0;
    box-shadow: black 0.125em 0.125em 1.5em;
}

#dashboard li a {
    background: var(--color4);
    color: var(--color7);
    border-radius: 0.5em 0;
    margin: 0.3125em 0;
    box-shadow: black 0.125em 0.125em 1.5em;
}

#dashboard li a:hover {
    background: var(--color3);
    color: var(--color5);
    border-radius: 0 0.5em;
    margin: 0.3125em 0;
    box-shadow: black 0.125em 0.125em 1.5em;
}

#main.dashboard {
    margin: 3em 1em;
}

#dashboard a,
#dashboard span {
    display: inline-block;
}

/*  Pseud dropdown  */

#dashboard .secondary {
    background: var(--color1);
    padding: 0.375em 0 0.625em;
    box-shadow: inset black 0.0625em 0.0625em 1em;
    border-radius: 0 1em;
}

ul.expandable.secondary > li > a {
    margin: 0 0.5em;
}

/*  USER & iCON */

.home .header h2 {
    text-align: right;
    border-bottom: 0.125em solid;
    display: block;
    margin: 0 100px;
    font-size: 1.2em;
}

.primary .icon {
    position: absolute;
    top: 0;
}

.icon {
    height: 5em;
    width: 5em;
}

.primary .icon a img,
.skins .primary .icon,
.admin .primary .icon {
    border: solid var(--color5) 0.3em;
    border-radius: 0 1.5em;
    box-shadow: 0.25em -0.25em 1em black;
}

.primary .icon a:hover {
    background: none;
}

p.icon,
.tag .primary .icon,
.tagset .primary .icon,
.admin .primary .icon {
    margin: 0 6em;
}

/* home user buttons */

.home .header ul.actions {
    margin-bottom: 0.643em;
    padding-top: 0;
}

.home .primary {
    margin: 0.5em 0 0.643em;
    min-height: 6.25em;
}

/*  LISTBOX: FANDOMS - WORKS - SERIES - BOOKMARKS  */

#user-fandoms {
    float: left;
    width: 24%;
    border-radius: 1em 0;
}

#user-fandoms .more.hidden {
    display: list-item;
}

#expand-fandoms {
    display: none;
}

#user-works {
    width: 73.5%;
    float: right;
    border-radius: 1em 0;
}

#user-series {
    border-radius: 0 1em;
}

#user-bookmarks {
    border-radius: 1em 0;
}

.listbox,
fieldset fieldset.listbox {
    background: var(--color1);
    box-shadow: 0 0 0 0.425em var(--color7);
    margin: 20px 3px;
    overflow: visible;
    border-radius: 1em 0;
}

.listbox > .heading {
    color: var(--color5);
    float: right;
    font-weight: bold;
    font-size: 90%;
    padding: 0.6em 0.3em;
}

.listbox .heading a:visited {
    color: var(--color5);
    float: right;
    font-weight: bold;
    font-size: 90%;
    border-radius: 0 0.5em;
}

.listbox .heading a:visited:hover {
    color: var(--color7);
    background: var(--color1);
}

.listbox .index {
    background: var(--color2);
    box-shadow: inset 1px 1px 8px black;
    border-radius: 1em 0;
}

#user-fandoms li a {
    color: var(--color5);
    background: var(--color7);
    padding: 0.125em;
    border-radius: 0.5em 0;
    box-shadow: black 0.125em 0.125em 1.5em;
    line-height: 2;
    border-bottom: none;
    font-size: 80%;
}

#user-fandoms li a:hover {
    color: var(--color7);
    background: var(--color5);
    padding: 0.125em;
    border-radius: 0 0.5em;
    box-shadow: black 0.125em 0.125em 1.5em;
    line-height: 2;
    border-bottom: none;
}

li.blurb,
fieldset,
form dl {
    border: 0;
    box-shadow: black 0.125em 0.125em 1.5em;
    border-radius: 1.5em 0;
}

.listbox li.blurb {
    box-shadow: black 0.125em 0.125em 1.5em;
    border-radius: 1em;
    background: var(--color3);
    margin: 0.75em;
}

h4.heading a {
    text-transform: uppercase;
    background: var(--color4);
    border-radius: 0.5em 0;
    box-shadow: black 0.0125em 0.0125em 1em;
}

.blurb h4 a:link {
    color: var(--color7);
    border: 0;
}

h4.heading a:hover {
    text-transform: uppercase;
    background: var(--color1);
    border-radius: 0 0.5em;
    box-shadow: black 0.0125em 0.0125em 1em;
}

.blurb h4 {
    text-transform: lowercase;
}

.blurb .header .heading,
.blurb .header ul {
    line-height: 1.5;
}

h5.fandoms.heading a:hover {
    background: var(--color7);
    border: solid 0.125em;
    padding: 0.125em;
}

ul.tags.commas {
    font-size: 85%;
}

ul.tags li.warnings,
ul.tags li.relationships,
ul.tags li.characters,
ul.tags li.freeforms {
    float: left !important;
    margin: 0.25em 0;
}

li.warnings + li.relationships,
li.relationships + li.characters,
li.characters + li.freeforms,
li.warnings + li.characters,
li.warnings + li.freeforms,
li.relationships + li.freeforms {
    clear: left;
}

ul.tags li {
    margin: 0;
}

ul.tags li a.tag {
    line-height: 1.5;
}

/* TAG SEPARATOR */

.commas li::after {
    content: none;
}

.commas li {
    display: inline;
}

.commas li:last-child:after,
.commas li:only-child:after {
    content: none;
}

span.series .previous + .divider::before, 
.commas li:after {
    content: " ★ ";
}

span.series .divider {
	color: var(--color5);
}

/*  TAGS  */

ul.tags li.warnings:first-child:before {
    content: "Archive Warnings: ";
    color: var(--color7);
    background: var(--color5);
    border-radius: 0 0.5em;
    font-weight: bold;
    box-shadow: black 0.0125em 0.0125em 1em;
    padding: 0.125em;
}

li.warnings + li.relationships:before {
    content: "Relationships: ";
    color: var(--color7);
    background: var(--color5);
    border-radius: 0 0.5em;
    font-weight: bold;
    box-shadow: black 0.0125em 0.0125em 1em;
    padding: 0.125em;
}

li.relationships + li.characters:before {
    content: "Characters: ";
    color: var(--color7);
    background: var(--color5);
    border-radius: 0 0.5em;
    font-weight: bold;
    box-shadow: black 0.0125em 0.0125em 1em;
    padding: 0.125em;
}

li.characters + li.freeforms:before {
    content: "Additional Tags: ";
    color: var(--color7);
    background: var(--color5);
    border-radius: 0 0.5em;
    font-weight: bold;
    box-shadow: black 0.0125em 0.0125em 1em;
    padding: 0.125em;
}

li.warnings + li.characters:before {
    content: "Characters: ";
    color: var(--color7);
    background: var(--color5);
    border-radius: 0 0.5em;
    font-weight: bold;
    box-shadow: black 0.0125em 0.0125em 1em;
    padding: 0.125em;
}

li.warnings + li.freeforms:before {
    content: "Additional Tags: ";
    color: var(--color7);
    background: var(--color5);
    border-radius: 0 0.5em;
    font-weight: bold;
    box-shadow: black 0.0125em 0.0125em 1em;
    padding: 0.125em;
}

li.relationships + li.freeforms:before {
    content: "Additional Tags: ";
    color: var(--color7);
    background: var(--color5);
    border-radius: 0 0.5em;
    font-weight: bold;
    box-shadow: black 0.0125em 0.0125em 1em;
    padding: 0.125em;
}

li.blurb ul.tags a {
    border-bottom: dotted 0.0625em var(--color5);
    margin: 0 0.25em;
}

li.blurb ul.tags li.relationships a {
    background: none;
    border-bottom: dotted 0.0625em var(--color5);
    margin: 0 0.25em;
}

li.blurb ul.tags li.warnings a {
    font-weight: normal;
}

.blurb blockquote {
    margin: 1em 2em;
    text-align: justify;
}

.userstuff hr {
    width: 33%;
    margin: 0.875em auto 1.2525em auto;
    border: 0.0625 solid;
    color: var(--color5);
}

dl.stats + .landmark + .actions,
.mystery .summary + .landmark + .actions {
    clear: inherit;
    float: left;
    margin: 1em auto;
}

/* Stats Icons */

dl.stats a,
dl.stats a:visited:hover,
p.kudos a {
    border-bottom: 1px dotted;
}

dl.stats {
    margin-left: -0.25em;
    margin-right: -0.25em;
}

/* hide the text before the stats */
dl.stats dt:not(.skins dl.stats dt) {
    display: none;
}

/* general settings for stats icons */
dl.stats dd:not(.skins dl.stats dd)::before {
    display: inline-block;
    width: 1.5em;
    height: 1.5em;
    margin-bottom: -0.35em;
    margin-right: 5px;
    content: "";
    background-size: 6em 13.5em !important;
    background-repeat: no-repeat !important;
    background-image: url("https://i.ibb.co/Gvqb9GDd/icons-skin-cute-xmas.png");
}

/* language */
dl.stats dd.language::before {
    background-position: 0 -0.75em;
}

/* Words*/
dl.stats dd.words::before,
.series .stats dd:first-of-type:not(dd.language)::before,
.bookmark.group:not(:has(.external-work)) dl.stats dd:first-of-type:not(dd.language)::before {
    background-position: -1.5em -0.75em;
}

/* Chapters */
dl.stats dd.chapters::before {
    background-position: -3em -0.75em;
}

/* Comments */
dl.stats dd.comments::before {
    background-position: -4.5em -0.75em;
}

/* Kudos */
dl.stats dd.kudos::before {
    background-position: 0 -3em;
}

/* Bookmarks */
dl.stats dd.bookmarks::before,
dl.stats dd:has(a[href$="bookmarks"])::before {
    background-position: -1.5em -3em;
}

/* Hits */
dl.stats dd.hits::before {
    background-position: -3em -3em;
}

/* works in series */
.series .stats dd:nth-of-type(2):not(dd.words)::before,
.bookmark.group:not(:has(.external-work)) dl.stats dd:nth-of-type(2):not(dd.words)::before,
dl.stats dd:has(a[href$="works"])::before {
    background-position: -4.5em -3em;
}

/* date published */
dl.work dl.stats dd.published::before {
    background-position: 0 -5.25em;
}

/* date updated/completed */
dl.work dl.stats dd.status::before {
    background-position: -1.5em -5.25em;
}

/* completion status (series) */
.series.meta.group .stats dd:nth-of-type(3)::before {
    background-position: -3em -5.25em;
}

/* collections */
dl.stats dd.collections::before {
    background-position: -4.5em -5.25em;
}

/* sub-collections*/
.collection dl.stats dd:has(a[href$="collections"])::before {
    background-position: 0 -7.5em;
}

/* fandoms */
dl.stats dd:has(a[href$="fandoms"])::before,
.tagset .stats dd:nth-of-type(1)::before {
    background-position: -1.5em -7.5em;
}

/* collections: bookmarked items */
.collection dl.stats dd:has(a[href$="bookmarks"])::before {
    background-position: -3em -7.5em;
}

/* collections: promts/requests */
dl.stats dd:has(a[href$="requests"])::before {
    background-position: -4.5em -7.5em;
}

/* related works (external bookmarks) */
.group li:has(.external-work) dl.stats dd:not(:first-of-type):last-of-type::before {
    background-position: 0 -9.75em;
}

/* subscriptions (statistics page) */
.statistics dl.stats dd.subscriptions::before {
    background-position: -1.5em -9.75em;
}

/* comment threads (statistics page) */
.statistics dl.stats dd.comments::before {
    background-position: -3em -9.75em;
}

/* tagsets: characters */
.tagset .stats dd:nth-of-type(2)::before {
    background-position: -4.5em -9.75em;
}

/* tagests: relationships */
.tagset .stats dd:nth-of-type(3)::before {
    background-position: 0 -12em;
}

/* tagsets: additional and freeform tags*/
.tagset .stats dd:nth-of-type(4)::before,
.tagset .meta .stats dd:nth-of-type(4)::before {
    background-position: -1.5em -12em;
}

/* stats hover text */

dl.stats dd::after {
    display: none;
    position: absolute;
    z-index: 99999;
    margin: 2em 0 0 -3.5em;
    padding: 0.1em 0.25em;
    border-radius: 0.25em;
    font-size: 0.85em;
    line-height: 1.3em;
